# Data: untracked by default (see README "A note on data").
# Add explicit exceptions below for small, public-domain example files
# (e.g., data/!fred_example.csv) rather than removing this blanket rule.
data/*
!data/.gitkeep
!data/uso_etf_daily.csv
!data/spy_etf_daily.csv
!data/market_excess_monthly.csv

# Never track anything that looks like a WRDS pull, even if placed elsewhere.
*wrds*

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db
