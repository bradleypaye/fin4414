# Data: untracked by default (see README "A note on data").
# Add explicit exceptions below for small, public-domain example files
# (e.g., data/!fred_example.csv) rather than removing this blanket rule.
data/*
!data/.gitkeep
!data/uso_etf_daily.csv
!data/spy_etf_daily.csv
!data/market_excess_monthly.csv
!data/ff_25_portfolios_5x5_monthly.csv
!data/ff_factors_monthly.csv
!data/ff_10_industry_portfolios_monthly.csv
!data/ff_investment_sorted_portfolios_monthly.csv
!data/ff_momentum_factor_monthly.csv
!data/fred_macro.csv

# Never track anything that looks like a WRDS pull, even if placed elsewhere.
*wrds*

# Graded course materials (homeworks, assessments, and their solutions) never
# belong in this public repo (see README) — they live on Canvas instead. Matched
# by name anywhere in the repo, in any format (.ipynb, .docx, .pdf, ...).
assessments/
Assessment*
Homework*
HW[0-9]*
*_Solution*
*_Solutions*

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Office lock files
~$*.doc*
~$*.xls*
~$*.ppt*
